{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchmesh.dev/schemas/phase2/v2/derived-evidence.schema.json",
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceAnalysis": { "type": "object", "properties": { "sourceEventId": { "$ref": "../../phase0/v1/identities.schema.json#/$defs/eventId" }, "sourceResourceId": { "$ref": "../../phase0/v1/identities.schema.json#/$defs/resourceId" }, "sourceVersion": { "$ref": "../../phase0/v1/identities.schema.json#/$defs/resourceVersion" }, "analysisInputDigest": { "$ref": "#/$defs/digest" } }, "required": ["sourceEventId", "sourceResourceId", "sourceVersion", "analysisInputDigest"], "additionalProperties": false },
    "proof": { "oneOf": [ { "type": "object", "properties": { "kind": { "const": "hash_bound_symbol_contract" }, "sourceAnalysis": { "$ref": "#/$defs/sourceAnalysis" } }, "required": ["kind", "sourceAnalysis"], "additionalProperties": false }, { "type": "object", "properties": { "kind": { "const": "resolver_confirmed_consumer_dependency" }, "sourceAnalysis": { "$ref": "#/$defs/sourceAnalysis" }, "resolver": { "type": "object", "properties": { "resolverId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }, "version": { "type": "string", "pattern": "^\\S(?:.*\\S)?$" } }, "required": ["resolverId", "version"], "additionalProperties": false }, "dependencyId": { "type": "string", "pattern": "^dep_[0-9a-f]{32}$" }, "consumerResourceId": { "$ref": "../../phase0/v1/identities.schema.json#/$defs/resourceId" }, "contractResourceId": { "$ref": "../../phase0/v1/identities.schema.json#/$defs/resourceId" }, "resolution": { "const": "confirmed" } }, "required": ["kind", "sourceAnalysis", "resolver", "dependencyId", "consumerResourceId", "contractResourceId", "resolution"], "additionalProperties": false } ] }
  },
  "type": "object",
  "properties": { "targetEventId": { "$ref": "../../phase0/v1/identities.schema.json#/$defs/eventId" }, "factKind": { "enum": ["symbol", "dependency"] }, "analyzer": { "type": "object", "properties": { "analyzerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }, "version": { "type": "string", "pattern": "^\\S(?:.*\\S)?$" } }, "required": ["analyzerId", "version"], "additionalProperties": false }, "configuration": { "type": "object", "additionalProperties": { "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } }, "configurationDigest": { "$ref": "#/$defs/digest" }, "sourceEventIds": { "type": "array", "items": { "$ref": "../../phase0/v1/identities.schema.json#/$defs/eventId" }, "minItems": 1, "uniqueItems": true }, "integrationTarget": { "type": "string", "pattern": "^\\S(?:.*\\S)?$" }, "coverage": { "type": "object", "properties": { "status": { "enum": ["sufficient", "degraded"] }, "reason": { "type": "string", "pattern": "^\\S(?:.*\\S)?$" } }, "required": ["status", "reason"], "additionalProperties": false }, "coverageId": { "$ref": "../../phase0/v1/coverage.schema.json#/$defs/coverageId" }, "stableFactId": { "oneOf": [{ "$ref": "../../phase0/v1/identities.schema.json#/$defs/resourceId" }, { "type": "string", "pattern": "^dep_[0-9a-f]{32}$" }] }, "exported": { "type": "boolean" }, "normalizedSignature": { "oneOf": [{ "type": "string", "pattern": "^\\S(?:.*\\S)?$" }, { "type": "null" }] }, "targetSnapshot": { "$ref": "../../phase0/v1/identities.schema.json#/$defs/targetSnapshot" }, "proof": { "$ref": "#/$defs/proof" } },
  "required": ["targetEventId", "factKind", "analyzer", "configuration", "configurationDigest", "sourceEventIds", "integrationTarget", "coverage", "coverageId", "stableFactId", "exported", "normalizedSignature", "targetSnapshot", "proof"], "additionalProperties": false
}
