{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patchmesh/evidence/trace-event-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "runId", "sequence", "timestamp", "agentId", "taskId", "worktreeId", "toolCallId", "parentRunId", "parentTaskId", "action", "paths", "resources", "result", "derivedEffect"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "pattern": "^trace_[A-Za-z0-9_-]+$" },
    "runId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "agentId": { "type": ["string", "null"] },
    "taskId": { "type": ["string", "null"] },
    "worktreeId": { "type": ["string", "null"] },
    "toolCallId": { "type": ["string", "null"] },
    "parentRunId": { "type": ["string", "null"] },
    "parentTaskId": { "type": ["string", "null"] },
    "action": { "type": "string", "minLength": 1 },
    "paths": { "type": "array", "items": { "type": "string" }, "maxItems": 128 },
    "resources": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "version"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": ["string", "null"] }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "durationMs", "exitCode", "errorClass", "outputDigest", "redactionCount"],
      "properties": {
        "status": { "enum": ["started", "succeeded", "failed", "interrupted", "rejected", "unknown"] },
        "durationMs": { "type": ["number", "null"], "minimum": 0 },
        "exitCode": { "type": ["integer", "null"] },
        "errorClass": { "type": ["string", "null"] },
        "outputDigest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "redactionCount": { "type": "integer", "minimum": 0 }
      }
    },
    "derivedEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "changedPaths", "resourceChanges", "confidence", "gaps"],
      "properties": {
        "status": { "enum": ["verified", "inferred", "degraded", "unknown"] },
        "changedPaths": { "type": "array", "items": { "type": "string" }, "maxItems": 128 },
        "resourceChanges": { "type": "array", "items": { "type": "object" }, "maxItems": 128 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "gaps": { "type": "array", "items": { "type": "string" }, "maxItems": 128 }
      }
    }
  }
}
