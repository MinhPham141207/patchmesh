{
  "permissions": {
    "allow": [
      "Bash(node apps/cli/dist/bin.js --help)",
      "mcp__patchmesh__patchmesh_recent_activity",
      "Bash(node -e 'const p=require\\(\"./apps/cli/package.json\"\\);console.log\\(JSON.stringify\\({bin:p.bin,main:p.main},null,1\\)\\)')",
      "Bash(node apps/cli/dist/main.js --help)"
    ]
  },
  "enabledMcpjsonServers": [
    "knowl",
    "patchmesh"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook claude SessionStart --json",
            "timeout": 30,
            "statusMessage": "Loading Knowl memory"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook claude SubagentStart --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook claude PreToolUse --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook claude PostToolUse --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/packages/recorder/dist/bin.js\"",
            "timeout": 10,
            "statusMessage": ""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook claude PostToolUseFailure --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook claude PreCompact --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook claude Stop --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/packages/recorder/dist/ingest-bin.js\"",
            "timeout": 60,
            "statusMessage": ""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook claude StopFailure --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook claude SubagentStop --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook claude SessionEnd --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/packages/recorder/dist/ingest-bin.js\"",
            "timeout": 60,
            "statusMessage": ""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-reminder claude --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/packages/recorder/dist/bin.js\"",
            "timeout": 10,
            "statusMessage": ""
          }
        ]
      }
    ]
  }
}
