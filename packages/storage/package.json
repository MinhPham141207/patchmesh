{
  "name": "patchmesh-storage",
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --import ../../tools/test/process-diagnostics.mjs --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "patchmesh-protocol": "workspace:*"
  },
  "description": "Append-only SQLite event store, deterministic replay, and work-graph projection for PatchMesh.",
  "license": "MIT",
  "author": "MinhPham141207",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhpham141207/patchmesh.git"
  },
  "bugs": {
    "url": "https://github.com/minhpham141207/patchmesh/issues"
  },
  "homepage": "https://github.com/minhpham141207/patchmesh#readme"
}
