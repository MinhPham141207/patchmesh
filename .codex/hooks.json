{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook codex SessionStart --json",
            "timeout": 30,
            "statusMessage": "Loading Knowl memory"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook codex SubagentStart --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook codex PostToolUse --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/patchmesh/packages/recorder/dist/codex-relay.js PostToolUse",
            "timeout": 10,
            "statusMessage": ""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook codex PostToolUseFailure --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/patchmesh/packages/recorder/dist/codex-relay.js PostToolUseFailure",
            "timeout": 10,
            "statusMessage": ""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook codex PreCompact --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook codex Stop --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/patchmesh/packages/recorder/dist/ingest-bin.js D:/patchmesh",
            "timeout": 60,
            "statusMessage": ""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/patchmesh/packages/recorder/dist/ingest-bin.js D:/patchmesh",
            "timeout": 60,
            "statusMessage": ""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "knowl.cmd agent-hook codex SubagentStop --json",
            "timeout": 30,
            "statusMessage": ""
          }
        ]
      }
    ]
  }
}
