{
  "name": "patchmesh",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "patchmesh": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --import ../../tools/test/process-diagnostics.mjs --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "patchmesh-daemon": "workspace:*",
    "patchmesh-gateway": "workspace:*",
    "patchmesh-protocol": "workspace:*",
    "patchmesh-query": "workspace:*",
    "patchmesh-recorder": "workspace:*",
    "patchmesh-storage": "workspace:*"
  },
  "description": "MCP server for parallel coding agents: detects file contention, coordinates claims, and prevents conflicts between agents working in the same repository.",
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "mcp",
    "coding-agent",
    "conflict-detection",
    "file-claims",
    "multi-agent",
    "coordination",
    "ledger",
    "observability"
  ],
  "license": "MIT",
  "author": "MinhPham141207",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhpham141207/patchmesh.git"
  },
  "bugs": {
    "url": "https://github.com/minhpham141207/patchmesh/issues"
  },
  "homepage": "https://github.com/minhpham141207/patchmesh#readme"
}
