{
  "name": "patchmesh",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "corepack pnpm --recursive build",
    "typecheck": "corepack pnpm --recursive typecheck",
    "test": "corepack pnpm build && corepack pnpm --recursive test",
    "phase1:typecheck": "corepack pnpm build && tsc -p tools/phase1/tsconfig.json --noEmit",
    "phase1:test": "corepack pnpm build && tsx --test \"tools/phase1/**/*.test.ts\"",
    "phase1:benchmark": "corepack pnpm build && tsx tools/phase1/benchmark.ts",
    "evidence:test": "node --test \"tools/evidence/*test.mjs\"",
    "evidence:validate": "node tools/evidence/validate-trace.mjs --all .evidence/trace",
    "evidence:benchmark": "node tools/evidence/benchmark.mjs --all --output .evidence/reports",
    "phase2:m0:benchmark": "corepack pnpm build && tsx tools/phase2/m0-benchmark.ts",
    "phase2:m0:verify": "corepack pnpm build && tsx tools/phase2/m0-verify.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
