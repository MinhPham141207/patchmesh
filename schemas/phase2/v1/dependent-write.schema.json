{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchmesh.dev/schemas/phase2/v1/dependent-write.schema.json",
  "type": "object",
  "properties": {
    "dependencyId": { "type": "string", "pattern": "^dep_[0-9a-f]{32}$" },
    "resourceId": { "$ref": "../../phase0/v1/identities.schema.json#/$defs/resourceId" },
    "dependsOnReadEventId": { "$ref": "../../phase0/v1/identities.schema.json#/$defs/eventId" },
    "coverageId": { "type": "string", "pattern": "^coverage_[0-9a-f]{32}$" },
    "comparison": {
      "type": "object",
      "properties": {
        "changedEventId": { "$ref": "../../phase0/v1/identities.schema.json#/$defs/eventId" },
        "coverageId": { "$ref": "../../phase0/v1/coverage.schema.json#/$defs/coverageId" },
        "integrationTarget": { "type": "string", "pattern": "^\\S(?:.*\\S)?$" }
      },
      "required": ["changedEventId", "coverageId", "integrationTarget"],
      "additionalProperties": false
    }
  },
  "required": ["dependencyId", "resourceId", "dependsOnReadEventId", "coverageId"],
  "additionalProperties": false
}
